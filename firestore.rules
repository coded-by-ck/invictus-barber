rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userExists() && userProfile().data.role == "admin";
    }

    function isBarber() {
      return userExists() && userProfile().data.role == "barber";
    }

    function currentBarberId() {
      return userProfile().data.barberId;
    }

    function isAllowedBarber(barberId) {
      return isBarber() && currentBarberId() == barberId;
    }

    function isStringField(data, field) {
      return data[field] is string && data[field].size() > 0;
    }

    function validBookingCreate(bookingId) {
      return request.auth == null &&
        request.resource.data.keys().hasOnly([
          "id",
          "service",
          "servicePrice",
          "servicePriceLabel",
          "serviceSnapshot",
          "barber",
          "barberId",
          "barberName",
          "clientName",
          "clientWhatsapp",
          "clientEmail",
          "date",
          "time",
          "duration",
          "endTime",
          "status",
          "createdAt",
          "cancelTokenId",
          "cancelTokenCreatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "id",
          "service",
          "barberId",
          "barberName",
          "clientName",
          "clientWhatsapp",
          "date",
          "time",
          "duration",
          "endTime",
          "status",
          "createdAt",
          "cancelTokenId"
        ]) &&
        request.resource.data.status == "confirmed" &&
        request.resource.data.id == bookingId &&
        isStringField(request.resource.data, "service") &&
        isStringField(request.resource.data, "barberId") &&
        isStringField(request.resource.data, "barberName") &&
        isStringField(request.resource.data, "clientName") &&
        isStringField(request.resource.data, "clientWhatsapp") &&
        isStringField(request.resource.data, "date") &&
        isStringField(request.resource.data, "time") &&
        isStringField(request.resource.data, "endTime") &&
        isStringField(request.resource.data, "createdAt") &&
        isStringField(request.resource.data, "cancelTokenId") &&
        request.resource.data.duration is number;
    }

    function validLockCreate() {
      return request.auth == null &&
        request.resource.data.keys().hasOnly([
          "bookingId",
          "barberId",
          "date",
          "time",
          "status",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "bookingId",
          "barberId",
          "date",
          "time",
          "status",
          "createdAt"
        ]) &&
        request.resource.data.status == "confirmed" &&
        isStringField(request.resource.data, "bookingId") &&
        isStringField(request.resource.data, "barberId") &&
        isStringField(request.resource.data, "date") &&
        isStringField(request.resource.data, "time") &&
        isStringField(request.resource.data, "createdAt");
    }

    function validTokenCreate(tokenId) {
      return request.auth == null &&
        request.resource.data.keys().hasOnly([
          "token",
          "bookingId",
          "barberId",
          "barberName",
          "barber",
          "service",
          "date",
          "time",
          "duration",
          "endTime",
          "status",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "token",
          "bookingId",
          "barberId",
          "date",
          "time",
          "status",
          "createdAt"
        ]) &&
        request.resource.data.token == tokenId &&
        request.resource.data.status == "active" &&
        isStringField(request.resource.data, "bookingId") &&
        isStringField(request.resource.data, "barberId") &&
        isStringField(request.resource.data, "date") &&
        isStringField(request.resource.data, "time") &&
        isStringField(request.resource.data, "createdAt") &&
        request.resource.data.duration is number;
    }

    function tokenActiveForBooking(tokenId, bookingId) {
      return tokenId is string &&
        exists(/databases/$(database)/documents/cancellationTokens/$(tokenId)) &&
        get(/databases/$(database)/documents/cancellationTokens/$(tokenId)).data.bookingId == bookingId &&
        get(/databases/$(database)/documents/cancellationTokens/$(tokenId)).data.status == "active";
    }

    function hasValidCancelProof(bookingId) {
      return request.resource.data.cancelTokenProof is string &&
        request.resource.data.cancelTokenProof == resource.data.cancelTokenId &&
        tokenActiveForBooking(request.resource.data.cancelTokenProof, bookingId);
    }

    function canClientCancelBooking(bookingId) {
      return request.auth == null &&
        resource.data.status == "confirmed" &&
        request.resource.data.status == "cancelled" &&
        request.resource.data.cancellationSource == "client" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "cancelledAt",
          "cancellationSource",
          "cancelTokenProof",
          "updatedAt"
        ]) &&
        hasValidCancelProof(bookingId);
    }

    function canClientCancelLock() {
      return request.auth == null &&
        resource.data.status == "confirmed" &&
        request.resource.data.status == "cancelled" &&
        request.resource.data.cancellationSource == "client" &&
        request.resource.data.cancelTokenProof is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "cancelledAt",
          "cancellationSource",
          "cancelTokenProof",
          "updatedAt"
        ]) &&
        exists(/databases/$(database)/documents/bookings/$(resource.data.bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.cancelTokenId == request.resource.data.cancelTokenProof &&
        tokenActiveForBooking(request.resource.data.cancelTokenProof, resource.data.bookingId);
    }

    function validTokenUse(tokenId) {
      return request.auth == null &&
        resource.data.status == "active" &&
        resource.data.token == tokenId &&
        request.resource.data.status == "used" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "usedAt"
        ]);
    }

    function validNotificationBase() {
      return request.resource.data.keys().hasOnly([
          "token",
          "userType",
          "uid",
          "barberId",
          "bookingId",
          "cancelTokenId",
          "active",
          "createdAt",
          "updatedAt",
          "userAgent"
        ]) &&
        request.resource.data.keys().hasAll([
          "token",
          "userType",
          "active",
          "updatedAt"
        ]) &&
        isStringField(request.resource.data, "token") &&
        isStringField(request.resource.data, "userType") &&
        request.resource.data.active is bool &&
        isStringField(request.resource.data, "updatedAt");
    }

    function validNotificationCreateBase() {
      return validNotificationBase() &&
        request.resource.data.keys().hasAll(["createdAt"]) &&
        isStringField(request.resource.data, "createdAt");
    }

    function validAdminNotification() {
      return signedIn() &&
        isAdmin() &&
        request.resource.data.userType == "admin" &&
        request.resource.data.uid == request.auth.uid &&
        !("barberId" in request.resource.data) &&
        !("bookingId" in request.resource.data) &&
        !("cancelTokenId" in request.resource.data);
    }

    function validBarberNotification() {
      return signedIn() &&
        isBarber() &&
        request.resource.data.userType == "barber" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.barberId == currentBarberId() &&
        !("bookingId" in request.resource.data) &&
        !("cancelTokenId" in request.resource.data);
    }

    function validClientNotificationProof() {
      return request.auth == null &&
        request.resource.data.userType == "client" &&
        isStringField(request.resource.data, "bookingId") &&
        isStringField(request.resource.data, "cancelTokenId") &&
        !("uid" in request.resource.data) &&
        !("barberId" in request.resource.data) &&
        exists(/databases/$(database)/documents/cancellationTokens/$(request.resource.data.cancelTokenId)) &&
        get(/databases/$(database)/documents/cancellationTokens/$(request.resource.data.cancelTokenId)).data.bookingId == request.resource.data.bookingId &&
        get(/databases/$(database)/documents/cancellationTokens/$(request.resource.data.cancelTokenId)).data.status == "active";
    }

    function canWriteNotificationToken() {
      return validNotificationBase() &&
        resource.data.userType == request.resource.data.userType &&
        (
          (
            validAdminNotification() &&
            resource.data.uid == request.auth.uid
          ) ||
          (
            validBarberNotification() &&
            resource.data.uid == request.auth.uid &&
            resource.data.barberId == currentBarberId()
          ) ||
          (
            validClientNotificationProof() &&
            resource.data.bookingId == request.resource.data.bookingId &&
            resource.data.cancelTokenId == request.resource.data.cancelTokenId
          )
        );
    }

    function canCreateNotificationToken() {
      return validNotificationCreateBase() &&
        (validAdminNotification() || validBarberNotification() || validClientNotificationProof());
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if validBookingCreate(bookingId);

      allow get: if isAdmin() ||
        isAllowedBarber(resource.data.barberId);

      allow list: if isAdmin() ||
        (isBarber() && resource.data.barberId == currentBarberId());

      allow update: if isAdmin() ||
        isAllowedBarber(resource.data.barberId) ||
        canClientCancelBooking(bookingId);

      allow delete: if false;
    }

    match /bookingLocks/{lockId} {
      allow get, list: if true;
      allow create: if validLockCreate();
      allow update: if isAdmin() ||
        isAllowedBarber(resource.data.barberId) ||
        canClientCancelLock();
      allow delete: if isAdmin() || isAllowedBarber(resource.data.barberId);
    }

    match /cancellationTokens/{tokenId} {
      allow get: if true;
      allow list: if false;
      allow create: if validTokenCreate(tokenId);
      allow update: if validTokenUse(tokenId);
      allow delete: if false;
    }

    match /notificationTokens/{tokenId} {
      allow get, list: if false;
      allow create: if canCreateNotificationToken();
      allow update: if canWriteNotificationToken();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
